PORT=8000

# OPTION 1: PostgreSQL 
DATABASE_DIALECT=postgres
ENABLE_DATABASE_SSL=false
# PEM CA for the DB server (required if you see SELF_SIGNED_CERT_IN_CHAIN). Multiline ok in .env locally.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Or single-line base64 of that PEM (good for DigitalOcean App Platform secrets):
# DATABASE_SSL_CA_B64=LS0tLS1CRUdJTi...
ENABLE_DATABASE_LOGGING=true
DATABASE_URL=postgresql://user:password@localhost:5432/stablecoin_rates

# OPTION 2: SQLite (Quick Setup for Development/Testing)
# DATABASE_DIALECT=sqlite
# DATABASE_URL=sqlite:./development.db
# ENABLE_DATABASE_SSL=false
# ENABLE_DATABASE_LOGGING=true
